# ─────────────────────────────────────────────────────────────
# Ecommency Task Manager — environment variables
# Copy this file to .env.local for local dev, and set the same
# values in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- App access (shared password gate) ---
# The password your team types to get into the app.
APP_PASSWORD=change-me-to-something-long

# A long random string used to sign the login cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-byte-string

# --- Google Sheets (the database) ---
# The ID from your sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# Service account email, e.g. ecommency-tasks@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Service account private key. Paste the whole key including the
# BEGIN/END lines. In Vercel, paste it exactly as-is (with real line
# breaks). In a local .env.local file, wrap it in double quotes and
# keep the literal \n sequences — the app converts them at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Email reminders (optional — not wired up yet) ---
# Left here so email can be dropped in later. See README "Adding email".
# CRON_SECRET=some-random-string
# RESEND_API_KEY=
# REMINDER_FROM_EMAIL=tasks@ecommency.com
# REMINDER_TO_EMAIL=you@ecommency.com
