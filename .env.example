# ─────────────────────────────────────────────────────────────
# Ecommency Task Manager — environment variables
# Copy this file to .env.local for local dev, and set the same
# values in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- App access (shared password gate) ---
# The password your team types to get into the app.
APP_PASSWORD=change-me-to-something-long

# A long random string used to sign the login cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-byte-string

# --- Database (Vercel Postgres / Neon) ---
# On Vercel you DON'T set this by hand: create the database under
# Project → Storage → Create Database → Postgres, and Vercel injects
# POSTGRES_URL (and friends) automatically.
#
# For local dev only, copy the POSTGRES_URL from your Vercel database's
# ".env.local" tab and paste it here.
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# --- Email → tasks (AI action-item extraction) ---
# Anthropic API key so Claude can read forwarded emails and suggest tasks.
# Get one at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret that protects the inbound-email webhook. Any random string.
# Your forwarding service calls /api/inbound?token=THIS_VALUE
INBOUND_TOKEN=change-me-to-a-random-string

# Optional: which Claude model does the extraction. Defaults to claude-opus-5.
# Set to claude-haiku-4-5 to cut cost if you want.
# EXTRACT_MODEL=claude-opus-5

# --- Email reminders (optional — not wired up yet) ---
# Left here so email reminders can be dropped in later. See README "Adding email".
# CRON_SECRET=some-random-string
# RESEND_API_KEY=
# REMINDER_FROM_EMAIL=tasks@ecommency.com
# REMINDER_TO_EMAIL=you@ecommency.com
